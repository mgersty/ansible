{{ ansible_managed | comment }}
# Passed to the container via `docker run --env-file`.
# Note: --env-file does no shell expansion and no quote stripping, so values
# must be literal. Paths here are CONTAINER paths, not host paths.

HF_HOME={{ vllm_container_models_dir }}
HF_HUB_CACHE={{ vllm_container_models_dir }}/hub
{% if vllm_hf_token | length > 0 %}
HF_TOKEN={{ vllm_hf_token }}
{% endif %}
{% if vllm_api_key | length > 0 %}
VLLM_API_KEY={{ vllm_api_key }}
{% endif %}
{% for key, value in vllm_environment | dictsort %}
{{ key }}={{ value }}
{% endfor %}
