{{ ansible_managed | comment }}
; llama.cpp router-mode model presets (mounted into the container at
; {{ llama_cpp_container_presets_file }}). See
; https://github.com/ggml-org/llama.cpp/blob/master/tools/server/README.md
; ("Model presets"): each [section] is one model, keys are CLI arguments
; without leading dashes. Sections whose name matches a model discovered in
; --models-dir overlay that model's auto-detected config (model path, mmproj,
; mtp- draft sidecar); the [*] section applies to every model; router CLI
; arguments override everything.
version = 1

; Defaults shared by every model instance.
[*]
gpu-layers = {{ llama_cpp_gpu_layers }}
flash-attn = {{ llama_cpp_flash_attn }}
; Load every listed model as soon as the service starts, so the first request
; (and systemd's verify) does not pay a cold-load latency. Remove a line to
; make that model load on demand instead.
load-on-startup = true

; Chat model: {{ llama_cpp_served_model_name }}
[{{ llama_cpp_served_model_name }}]
ctx-size = {{ llama_cpp_ctx_size }}
{% if llama_cpp_model_draft_file | default('') | length > 0 %}
; The draft head is auto-detected from the mtp- sidecar in the model
; subdirectory; name the speculative path explicitly (llama.cpp would also
; infer draft-mtp from the head's GGUF metadata).
spec-type = draft-mtp
spec-draft-n-max = {{ llama_cpp_spec_draft_n_max }}
{% endif %}
; Keep the model's <tool_call> output in
; message.reasoning_content instead of inline in message.content.
reasoning-format = {{ llama_cpp_reasoning_format }}

; Decision model: {{ llama_cpp_decision_model_name }} (POST /v1/systemone)
[{{ llama_cpp_decision_model_name }}]
ctx-size = {{ llama_cpp_decision_ctx_size }}
